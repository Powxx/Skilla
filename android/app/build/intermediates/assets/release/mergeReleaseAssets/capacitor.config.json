{
	"appId": "fr.ecmacademie.skilla",
	"appName": "Skilla",
	"webDir": "mobile-dist",
	"server": {
		"url": "https://skilla.ecm-academie.com",
		"cleartext": false,
		"androidScheme": "https"
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 1500,
			"launchAutoHide": true,
			"backgroundColor": "#ffffff",
			"showSpinner": false
		},
		"StatusBar": {
			"style": "DARK",
			"backgroundColor": "#0f172a",
			"overlaysWebView": false
		},
		"SystemBars": {
			"insetsHandling": "css",
			"style": "DARK"
		}
	}
}
