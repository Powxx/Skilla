generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- ENUMS ---
enum Role {
  SUPER_ADMIN
  ADMIN
  TEACHER
  STUDENT
  RESPONSIBLE
  COMPANY_TUTOR
}

enum SubstitutionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum InternshipType {
  APPRENTICESHIP
  INTERNSHIP
}

enum RhythmType {
  WEEKLY
  ALTERNANCE_1_3
  ALTERNANCE_1_4
}

// --- UTILISATEURS ---
model Dispensation {
  id        String   @id @default(cuid())
  studentId String
  student   User     @relation("StudentDispensation", fields: [studentId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  reason    String?
  createdAt DateTime @default(now())

  @@unique([studentId, subjectId])
}

model User {
  id            String  @id @default(cuid())
  email         String? @unique
  username      String? @unique
  password      String?
  role          Role    @default(STUDENT)
  calendarToken String? @unique @default(cuid())

  // Noms : On garde les deux pour supporter ton code de création et de login
  name      String? // Format combiné "Prénom Nom"
  firstName String?
  lastName  String?

  phone     String?
  address   String?
  birthday  DateTime?
  createdAt DateTime  @default(now())

  // Relations Profil & Classe
  studentProfile StudentProfile?
  classId        String?
  class          Class?          @relation(fields: [classId], references: [id])
  dispensations  Dispensation[]  @relation("StudentDispensation")

  // Relations Responsables (Self-relation pour les parents/tuteurs)
  students     User[] @relation("UserToResponsible")
  responsibles User[] @relation("UserToResponsible")

  // Relations Entreprises
  studentContracts CompanyContract[] @relation("StudentInCompany")
  tutorContracts   CompanyContract[] @relation("TutorInCompany")

  // Relations Enseignement
  subjects      Subject[]
  lessons       Lesson[]         @relation("TeacherLessons")
  substitutions Lesson[]         @relation("SubstituteTeacher")
  contract      TeacherContract?
  skillMatrix   SkillMatrix[]

  // Relations Pédagogiques
  grades      Grade[]
  absences    Attendance[]
  reportCards ReportCard[]
  evaluations Evaluation[]

  // Substitution Requests
  substitutionRequestsSent     SubstitutionRequest[] @relation("OriginalTeacher")
  substitutionRequestsReceived SubstitutionRequest[] @relation("SubstituteTeacherReq")

  // Qualiopi & Feedback
  complaints          Complaint[]            @relation("Sender")
  surveys             SatisfactionSurvey[]
  meetingRequestsSent MeetingRequest[]       @relation("MeetingSender")
  notifications       Notification[]
  sentNotifications   ClassNotificationLog[] @relation("NotificationSender")
  pushSubscriptions   PushSubscription[]
  gameScores          GameScore[]
  assignedGrades      Grade[]                @relation("TeacherGrades")

  // Gamification & Assiduité
  loginStreak    Int                   @default(0)
  lastLoginAt    DateTime?
  availabilities TeacherAvailability[]

  // Habilitations spécifiques
  canAccessLivrets  Boolean @default(false)
  canManageUsers    Boolean @default(false)
  canManageSettings Boolean @default(false)
  canManagePlanning Boolean @default(false)
  canManageRH       Boolean @default(false)
  canImpersonate    Boolean @default(false)
  isActive          Boolean @default(true)
  deletionRequested Boolean @default(false)

  // Système de points de conduite (activable par l'admin)
  conductPoints     Int     @default(100)

  // Chat system
  conversationsAs1 Conversation[] @relation("Participant1")
  conversationsAs2 Conversation[] @relation("Participant2")
  sentMessages     ChatMessage[]  @relation("SentMessages")

  studentSanctions   Sanction[]            @relation("StudentSanctions")
  givenSanctions     Sanction[]            @relation("GivenSanctions")
  sanctionComments   SanctionComment[]     @relation("SanctionCommentAuthor")
  sanctionEvents     SanctionActionEvent[] @relation("SanctionEventStudent")
  surveyCampaigns    SatisfactionSurveyCampaign[] @relation("SurveyCampaignCreator")

  @@index([role])
  @@index([lastName, firstName])
}

// ... existing models ...

model Conversation {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  participant1Id String
  participant1   User   @relation("Participant1", fields: [participant1Id], references: [id], onDelete: Cascade)

  participant2Id String
  participant2   User   @relation("Participant2", fields: [participant2Id], references: [id], onDelete: Cascade)

  messages ChatMessage[]

  @@unique([participant1Id, participant2Id])
  @@index([participant1Id])
  @@index([participant2Id])
}

model ChatMessage {
  id             String   @id @default(cuid())
  content        String   @db.Text
  createdAt      DateTime @default(now())
  isRead         Boolean  @default(false)

  senderId       String
  sender         User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
}

model TeacherAvailability {
  id        String @id @default(cuid())
  dayOfWeek Int // 0 (Sunday) to 6 (Saturday)
  startTime String // "HH:mm"
  endTime   String // "HH:mm"
  teacherId String
  teacher   User   @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
}

model GlobalSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

// Pour le chat, on utilisera la clé 'CHAT_ENABLED' dans GlobalSetting


model StudentProfile {
  id      String @id @default(cuid())
  userId  String @unique
  user    User   @relation(fields: [userId], references: [id])
  classId String
}

// --- STRUCTURE PÉDAGOGIQUE ---
model Class {
  id               String            @id @default(cuid())
  name             String            @unique
  rhythm           RhythmType        @default(WEEKLY)
  cycleWeeks       Int               @default(1) // Number of weeks in a cycle
  reportCardsVisible Boolean         @default(true)
  students         User[]
  lessons          Lesson[]
  attendanceSheets AttendanceSheet[]
  competencies     ClassCompetency[]
  notifications    ClassNotificationLog[]
  requirements     ClassSubjectRequirement[]
  surveyCampaigns  SatisfactionSurveyCampaign[]
}

model ClassSubjectRequirement {
  id          String  @id @default(cuid())
  classId     String
  subjectId   String
  weeklyHours Float
  class       Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject     Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([classId, subjectId])
}

model Room {
  id       String   @id @default(cuid())
  name     String   @unique
  capacity Int?
  lessons  Lesson[]
}

model Subject {
  id                       String                    @id @default(cuid())
  name                     String                    @unique
  teachers                 User[]
  lessons                  Lesson[]
  grades                   Grade[]
  skillMatrix              SkillMatrix[]
  dispensations            Dispensation[]
  classSubjectRequirements ClassSubjectRequirement[]
}

model SchoolYear {
  id        String     @id @default(cuid())
  name      String     @unique  // ex: "2025-2026"
  startDate DateTime
  endDate   DateTime
  semesters Semester[]
}

model Semester {
  id           String       @id @default(cuid())
  name         String
  startDate    DateTime
  endDate      DateTime
  schoolYearId String?
  schoolYear   SchoolYear?  @relation(fields: [schoolYearId], references: [id])
  grades       Grade[]
  reportCards  ReportCard[]
  evaluations  Evaluation[]

  @@index([schoolYearId])
}

// --- PLANNING & ÉMARGEMENT ---
model Lesson {
  id                    String   @id @default(cuid())
  startTime             DateTime
  endTime               DateTime
  isCancelled           Boolean  @default(false)
  isAttendanceValidated Boolean  @default(false)
  isFreeLesson          Boolean  @default(false)
  customSubject         String?
  customTeacher         String?

  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id])

  teacherId String?
  teacher   User?    @relation("TeacherLessons", fields: [teacherId], references: [id])

  substituteId    String?
  substitute      User?   @relation("SubstituteTeacher", fields: [substituteId], references: [id])
  replacementNote String?

  classId String
  class   Class  @relation(fields: [classId], references: [id])

  roomId  String?
  room    Room?   @relation(fields: [roomId], references: [id])
  groupId String?
  recurrenceId String?

  attendances Attendance[]

  attendanceSheetId    String?
  attendanceSheet      AttendanceSheet?      @relation(fields: [attendanceSheetId], references: [id])
  substitutionRequests SubstitutionRequest[]

  summary  String? @db.Text
  homework String? @db.Text

  @@index([startTime, endTime])
  @@index([recurrenceId])
}

model AttendanceSheet {
  id      String   @id @default(cuid())
  date    DateTime @default(now())
  classId String
  class   Class    @relation(fields: [classId], references: [id])
  lessons Lesson[]
}

model Attendance {
  id           String           @id @default(cuid())
  status       AttendanceStatus @default(PRESENT)
  lateDuration Int?
  reason       String?
  lessonId     String
  lesson       Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  studentId    String
  student      User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

// --- NOTES & BULLETINS ---
model Grade {
  id          String   @id @default(cuid())
  value       Float
  coefficient Float    @default(1.0)
  subjectName String? // Stockage du nom pour historique
  comment     String?
  createdAt   DateTime @default(now())

  studentId String
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  teacherId String?
  teacher   User?   @relation("TeacherGrades", fields: [teacherId], references: [id])

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  semesterId String
  semester   Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
}

model ReportCard {
  id               String   @id @default(cuid())
  generalAppraisal String?
  distinction      String?
  semesterId       String
  semester         Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  studentId        String
  student          User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, semesterId])
}

// --- ENTREPRISE & RH ---
model CompanyContract {
  id          String         @id @default(cuid())
  companyName String
  type        InternshipType
  startDate   DateTime
  endDate     DateTime
  studentId   String
  student     User           @relation("StudentInCompany", fields: [studentId], references: [id])
  tutorId     String
  tutor       User           @relation("TutorInCompany", fields: [tutorId], references: [id])
}

model TeacherContract {
  id           String @id @default(cuid())
  hourlyRate   Float
  annualHours  Float  @default(0)
  teacherId    String @unique
  teacher      User   @relation(fields: [teacherId], references: [id])
}

// --- MODULES QUALIOPI ---
model Evaluation {
  id         String   @id @default(cuid())
  competency String
  level      Int
  source     String
  category   String   @default("SCHOOL") // "SCHOOL" or "ENTERPRISE"
  studentId  String
  student    User     @relation(fields: [studentId], references: [id])
  semesterId String?
  semester   Semester? @relation(fields: [semesterId], references: [id])
  updatedAt  DateTime @updatedAt
}

model ClassCompetency {
  id       String @id @default(cuid())
  name     String
  category String // "SCHOOL" or "ENTERPRISE"
  classId  String
  class    Class  @relation(fields: [classId], references: [id])
}

model SkillMatrix {
  id        String  @id @default(cuid())
  teacherId String
  teacher   User    @relation(fields: [teacherId], references: [id])
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])
}

model Complaint {
  id          String   @id @default(cuid())
  subject     String
  description String
  status      String   @default("OPEN")
  senderId    String
  sender      User     @relation("Sender", fields: [senderId], references: [id])
  createdAt   DateTime @default(now())
}

model SubstitutionRequest {
  id                  String             @id @default(cuid())
  lessonId            String
  lesson              Lesson             @relation(fields: [lessonId], references: [id])
  originalTeacherId   String
  originalTeacher     User               @relation("OriginalTeacher", fields: [originalTeacherId], references: [id])
  substituteTeacherId String?
  substituteTeacher   User?              @relation("SubstituteTeacherReq", fields: [substituteTeacherId], references: [id])
  status              SubstitutionStatus @default(PENDING)
  createdAt           DateTime           @default(now())
}

enum MeetingStatus {
  PENDING
  SCHEDULED
  REJECTED
  COMPLETED
}

model MeetingRequest {
  id          String        @id @default(cuid())
  senderId    String
  sender      User          @relation("MeetingSender", fields: [senderId], references: [id])
  reason      String
  status      MeetingStatus @default(PENDING)
  requestedAt DateTime      @default(now())
  scheduledAt DateTime?
  adminNotes  String?
}

model SatisfactionSurveyCampaign {
  id          String                   @id @default(cuid())
  title       String
  description String?                  @db.Text
  targetType  SatisfactionSurveyTarget
  classId     String?
  class       Class?                   @relation(fields: [classId], references: [id], onDelete: SetNull)
  isActive    Boolean                  @default(true)
  createdAt   DateTime                 @default(now())
  createdById String
  createdBy   User                     @relation("SurveyCampaignCreator", fields: [createdById], references: [id], onDelete: Cascade)
  responses   SatisfactionSurvey[]

  @@index([createdAt])
  @@index([isActive])
}

enum SatisfactionSurveyTarget {
  STUDENT
  TEACHER
  RESPONSIBLE
  COMPANY_TUTOR
  CLASS
}

model SatisfactionSurvey {
  id         String                      @id @default(cuid())
  rating     Int
  comment    String?                     @db.Text
  userId     String
  user       User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignId String?
  campaign   SatisfactionSurveyCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  createdAt  DateTime                    @default(now())

  @@unique([userId, campaignId])
  @@index([userId])
  @@index([campaignId])
}

model Notification {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  title      String
  message    String
  type       String   @default("INFO") // INFO, WARNING, SUCCESS, ERROR
  isRead     Boolean  @default(false)
  link       String? // Optional link to navigate to
  senderName String   @default("Système")
  createdAt  DateTime @default(now())
}

model ClassNotificationLog {
  id        String   @id @default(cuid())
  senderId  String
  sender    User     @relation("NotificationSender", fields: [senderId], references: [id])
  classId   String
  class     Class    @relation(fields: [classId], references: [id])
  title     String
  message   String
  createdAt DateTime @default(now())
}

model NotificationConfig {
  id          String   @id @default(cuid())
  event       String   @unique // e.g., "NEW_GRADE", "MEETING_UPDATE"
  isEnabled   Boolean  @default(true)
  title       String // Default title template
  message     String // Default message template
  targetRoles Role[]   @default([STUDENT])
  updatedAt   DateTime @updatedAt
}

model Holiday {
  id   String   @id @default(cuid())
  date DateTime @unique
  name String
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model GameScore {
  id        String   @id @default(cuid())
  gameKey   String // Clé identifiant le jeu (ex: "katana-scissors")
  score     Int
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, gameKey])
  @@index([gameKey])
  @@index([userId])
}

model SanctionType {
  id           String     @id @default(cuid())
  name         String     @unique
  description  String?
  allowTeacher Boolean    @default(false)
  allowAdmin   Boolean    @default(true)
  sanctions    Sanction[]
  createdAt    DateTime   @default(now())
}

enum SanctionStatus {
  PLANIFIE
  REALISE
  NON_PRESENT
  EXCUSE
}

model Sanction {
  id             String         @id @default(cuid())
  studentId      String
  student        User           @relation("StudentSanctions", fields: [studentId], references: [id], onDelete: Cascade)
  sanctionTypeId String
  sanctionType   SanctionType   @relation(fields: [sanctionTypeId], references: [id], onDelete: Cascade)
  reason         String         @db.Text
  givenById      String
  givenBy        User           @relation("GivenSanctions", fields: [givenById], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())
  date           DateTime       @default(now())
  duration       String?        // e.g. "2 heures", "3 jours" (optionnel)
  status         SanctionStatus @default(PLANIFIE)
  pointsCost     Int            @default(0) // Points de conduite retirés (si système activé)
  comments       SanctionComment[]
  actionEvents   SanctionActionEvent[]

  @@index([studentId])
  @@index([givenById])
  @@index([date])
}

// Commentaires sur une sanction (activable par toggle admin)
model SanctionComment {
  id         String   @id @default(cuid())
  sanctionId String
  sanction   Sanction @relation(fields: [sanctionId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation("SanctionCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body       String   @db.Text
  createdAt  DateTime @default(now())

  @@index([sanctionId])
}

// Événements générés automatiquement par le système de points
model SanctionActionEvent {
  id          String   @id @default(cuid())
  studentId   String
  student     User     @relation("SanctionEventStudent", fields: [studentId], references: [id], onDelete: Cascade)
  sanctionId  String?
  sanction    Sanction? @relation(fields: [sanctionId], references: [id], onDelete: SetNull)
  type        String   // e.g. "POINTS_DEDUCTED", "THRESHOLD_50", "THRESHOLD_20"
  description String
  createdAt   DateTime @default(now())

  @@index([studentId])
}
