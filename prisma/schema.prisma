generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- ENUMS ---
enum Role {
  ADMIN
  TEACHER
  STUDENT
  RESPONSIBLE
  COMPANY_TUTOR
}

enum SubstitutionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum InternshipType {
  APPRENTICESHIP
  INTERNSHIP
}

enum RhythmType {
  WEEKLY
  ALTERNANCE_1_3
}

// --- UTILISATEURS ---
model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  password      String?
  role          Role      @default(STUDENT)
  
  // Noms : On garde les deux pour supporter ton code de création et de login
  name          String?   // Format combiné "Prénom Nom"
  firstName     String?
  lastName      String?
  
  phone         String?
  address       String?
  birthday      DateTime?
  createdAt     DateTime  @default(now())

  // Relations Profil & Classe
  studentProfile StudentProfile?
  classId        String?
  class          Class?          @relation(fields: [classId], references: [id])

  // Relations Responsables (Self-relation pour les parents/tuteurs)
  students      User[]    @relation("UserToResponsible")
  responsibles  User[]    @relation("UserToResponsible")
  
  // Relations Entreprises
  studentContracts CompanyContract[] @relation("StudentInCompany")
  tutorContracts   CompanyContract[] @relation("TutorInCompany")

  // Relations Enseignement
  subjects      Subject[] 
  lessons       Lesson[]          @relation("TeacherLessons")
  substitutions Lesson[]          @relation("SubstituteTeacher")
  contract      TeacherContract?
  skillMatrix   SkillMatrix[]

  // Relations Pédagogiques
  grades        Grade[]
  absences      Attendance[]
  reportCards   ReportCard[]
  evaluations   Evaluation[] 
  
  // Substitution Requests
  substitutionRequestsSent     SubstitutionRequest[] @relation("OriginalTeacher")
  substitutionRequestsReceived SubstitutionRequest[] @relation("SubstituteTeacherReq")

  // Qualiopi & Feedback
  complaints    Complaint[]       @relation("Sender")
  surveys       SatisfactionSurvey[]
}

model StudentProfile {
  id      String @id @default(cuid())
  userId  String @unique
  user    User   @relation(fields: [userId], references: [id])
  classId String
}

// --- STRUCTURE PÉDAGOGIQUE ---
model Class {
  id               String            @id @default(cuid())
  name             String            @unique
  rhythm           RhythmType        @default(WEEKLY)
  students         User[]
  lessons          Lesson[]
  attendanceSheets AttendanceSheet[]
}

model Room {
  id       String   @id @default(cuid())
  name     String   @unique
  capacity Int?
  lessons  Lesson[]
}

model Subject {
  id          String        @id @default(cuid())
  name        String        @unique
  teachers    User[]
  lessons     Lesson[]
  grades      Grade[]
  skillMatrix SkillMatrix[]
}

model Semester {
  id          String       @id @default(cuid())
  name        String
  startDate   DateTime
  endDate     DateTime
  grades      Grade[]
  reportCards ReportCard[]
}

// --- PLANNING & ÉMARGEMENT ---
model Lesson {
  id                String           @id @default(cuid())
  startTime         DateTime
  endTime           DateTime
  isCancelled       Boolean          @default(false)
  
  subjectId         String
  subject           Subject          @relation(fields: [subjectId], references: [id])
  
  teacherId         String
  teacher           User             @relation("TeacherLessons", fields: [teacherId], references: [id])
  
  substituteId      String?
  substitute        User?            @relation("SubstituteTeacher", fields: [substituteId], references: [id])
  replacementNote   String?

  classId           String
  class             Class            @relation(fields: [classId], references: [id])
  
  roomId            String?
  room              Room?            @relation(fields: [roomId], references: [id])
  
  attendances       Attendance[]
  attendanceSheetId String?
  attendanceSheet   AttendanceSheet? @relation(fields: [attendanceSheetId], references: [id])
  substitutionRequests SubstitutionRequest[]
}

model AttendanceSheet {
  id      String   @id @default(cuid())
  date    DateTime @default(now())
  classId String
  class   Class    @relation(fields: [classId], references: [id])
  lessons Lesson[]
}

model Attendance {
  id           String           @id @default(cuid())
  status       AttendanceStatus @default(PRESENT)
  lateDuration Int?
  reason       String?
  lessonId     String
  lesson       Lesson           @relation(fields: [lessonId], references: [id])
  studentId    String
  student      User             @relation(fields: [studentId], references: [id])
}

// --- NOTES & BULLETINS ---
model Grade {
  id           String   @id @default(cuid())
  value        Float
  coefficient  Float    @default(1.0)
  subjectName  String?  // Stockage du nom pour historique
  comment      String?  
  createdAt    DateTime @default(now())

  studentId    String
  student      User     @relation(fields: [studentId], references: [id])
  
  subjectId    String
  subject      Subject  @relation(fields: [subjectId], references: [id])
  
  semesterId   String
  semester     Semester @relation(fields: [semesterId], references: [id])
}

model ReportCard {
  id                String   @id @default(cuid())
  generalAppraisal  String?
  distinction       String?  
  semesterId        String
  semester          Semester @relation(fields: [semesterId], references: [id])
  studentId         String
  student           User     @relation(fields: [studentId], references: [id])
}

// --- ENTREPRISE & RH ---
model CompanyContract {
  id          String         @id @default(cuid())
  companyName String
  type        InternshipType
  startDate   DateTime
  endDate     DateTime
  studentId   String
  student     User           @relation("StudentInCompany", fields: [studentId], references: [id])
  tutorId     String
  tutor       User           @relation("TutorInCompany", fields: [tutorId], references: [id])
}

model TeacherContract {
  id           String @id @default(cuid())
  hourlyRate   Float
  monthlyHours Float
  teacherId    String @unique
  teacher      User   @relation(fields: [teacherId], references: [id])
}

// --- MODULES QUALIOPI ---
model Evaluation {
  id          String @id @default(cuid())
  competency  String
  level       Int      
  source      String   
  studentId   String
  student     User   @relation(fields: [studentId], references: [id])
}

model SkillMatrix {
  id        String  @id @default(cuid())
  teacherId String
  teacher   User    @relation(fields: [teacherId], references: [id])
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])
}

model Complaint {
  id          String   @id @default(cuid())
  subject     String
  description String
  status      String   @default("OPEN")
  senderId    String
  sender      User     @relation("Sender", fields: [senderId], references: [id])
  createdAt   DateTime @default(now())
}

model SubstitutionRequest {
  id                 String             @id @default(cuid())
  lessonId           String
  lesson             Lesson             @relation(fields: [lessonId], references: [id])
  originalTeacherId  String
  originalTeacher    User               @relation("OriginalTeacher", fields: [originalTeacherId], references: [id])
  substituteTeacherId String
  substituteTeacher  User               @relation("SubstituteTeacherReq", fields: [substituteTeacherId], references: [id])
  status             SubstitutionStatus @default(PENDING)
  createdAt          DateTime           @default(now())
}

model SatisfactionSurvey {
  id        String @id @default(cuid())
  rating    Int
  studentId String
  student   User   @relation(fields: [studentId], references: [id])
}